{
  "name": "bot",
  "version": "0.1.0",
  "description": "基于 pi-durable 的多 Agent 沙盒对话网关 (终端 TUI / IM 渠道 / Web 管理台 / 定时任务)",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "bot": "./bin/bot"
  },
  "scripts": {
    "dev": "bun run src/cli.ts start",
    "dev:web": "bun run scripts/dev-web.ts",
    "build:web": "cd web && bunx vite build && cd .. && bun run scripts/embed-web.ts",
    "build:binary": "bun run build:web && bun build src/cli.ts --compile --minify --outfile bin/bot",
    "build:release": "bun run scripts/build-release.ts --all",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.78",
    "@earendil-works/chord": "^1.0.2",
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-durable": "^1.0.2",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "axios": "^1.20.0",
    "croner": "^10.0.1",
    "ink": "^8.0.0",
    "qrcode": "^1.5.4",
    "react-devtools-core": "file:./vendor/react-devtools-core-stub",
    "typebox": "^1.3.27",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.2"
  }
}
